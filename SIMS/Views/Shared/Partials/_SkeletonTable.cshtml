@model int?
@{
    var rows = Model ?? (ViewData["SkeletonRows"] as int?) ?? 5;
    var showCards = ViewData["SkeletonCards"] as bool? ?? true;
}

<div class="space-y-5">
    @if (showCards)
    {
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            @for (var card = 0; card < 4; card++)
            {
                <div class="kpi-card animate-pulse space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="skeleton h-4 w-24"></div>
                        <div class="skeleton h-8 w-8 rounded-lg"></div>
                    </div>
                    <div class="skeleton h-8 w-32"></div>
                    <div class="skeleton h-3 w-40"></div>
                </div>
            }
        </div>
    }

    <div class="overflow-hidden rounded-xl border border-light-border bg-light-surface shadow-sm dark:border-dark-border dark:bg-dark-surface">
        <div class="flex items-center justify-between border-b border-light-border p-4 dark:border-dark-border">
            <div class="skeleton h-9 w-64 rounded-lg"></div>
            <div class="flex gap-2">
                <div class="skeleton h-9 w-24 rounded-lg"></div>
                <div class="skeleton h-9 w-28 rounded-lg"></div>
            </div>
        </div>
        <div class="divide-y divide-light-border p-4 dark:divide-dark-border">
            @for (var row = 0; row < rows; row++)
            {
                <div class="flex items-center justify-between py-3">
                    <div class="flex items-center gap-3">
                        <div class="skeleton h-8 w-8 rounded-full"></div>
                        <div class="space-y-1.5">
                            <div class="skeleton h-4 w-36"></div>
                            <div class="skeleton h-3 w-48"></div>
                        </div>
                    </div>
                    <div class="skeleton hidden h-4 w-28 md:block"></div>
                    <div class="skeleton h-6 w-20 rounded-full"></div>
                    <div class="skeleton h-4 w-16"></div>
                </div>
            }
        </div>
    </div>
</div>
