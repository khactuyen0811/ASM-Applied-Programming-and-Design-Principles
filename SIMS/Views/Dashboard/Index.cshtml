@model DashboardStats
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Breadcrumb"] = "Admin Overview";
    ViewData["ActiveNav"] = "dashboard";

    var trend = ViewData["Trend"] as IReadOnlyList<ChartPoint> ?? Array.Empty<ChartPoint>();
    var maxTrend = trend.Count == 0 ? 1 : Math.Max(1, trend.Max(p => p.Value));
    var maxCourse = Model.EnrollmentsByCourse.Count == 0 ? 1 : Math.Max(1, Model.EnrollmentsByCourse.Max(p => p.Value));
    var maxProgram = Model.StudentsByProgram.Count == 0 ? 1 : Math.Max(1, Model.StudentsByProgram.Max(p => p.Value));
}

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="page-title">Institutional Overview</h2>
            <p class="page-subtitle">Live registrar metrics across students, courses, faculty and enrollment activity.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a asp-controller="Student" asp-action="Create" class="btn btn-secondary">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>Register Student</span>
            </a>
            <a asp-controller="Enrollment" asp-action="Index" class="btn btn-primary">
                <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
                <span>Manage Enrollments</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="kpi-card">
            <div class="flex items-center justify-between">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Total Students</span>
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-container text-primary"><span class="material-symbols-outlined text-[20px]">groups</span></span>
            </div>
            <div class="mt-3 font-headline text-headline-xl font-bold text-light-on-surface tabular-nums dark:text-dark-on-surface">@Model.TotalStudents</div>
            <div class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">@Model.ActiveStudents active learners</div>
        </div>
        <div class="kpi-card">
            <div class="flex items-center justify-between">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Courses</span>
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent-container text-accent"><span class="material-symbols-outlined text-[20px]">menu_book</span></span>
            </div>
            <div class="mt-3 font-headline text-headline-xl font-bold text-light-on-surface tabular-nums dark:text-dark-on-surface">@Model.TotalCourses</div>
            <div class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">Catalog offerings this term</div>
        </div>
        <div class="kpi-card">
            <div class="flex items-center justify-between">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Faculty</span>
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-warning-container text-warning"><span class="material-symbols-outlined text-[20px]">badge</span></span>
            </div>
            <div class="mt-3 font-headline text-headline-xl font-bold text-light-on-surface tabular-nums dark:text-dark-on-surface">@Model.TotalTeachers</div>
            <div class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">Active teaching staff</div>
        </div>
        <div class="kpi-card">
            <div class="flex items-center justify-between">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Enrollments</span>
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-success-container text-success"><span class="material-symbols-outlined text-[20px]">task_alt</span></span>
            </div>
            <div class="mt-3 font-headline text-headline-xl font-bold text-light-on-surface tabular-nums dark:text-dark-on-surface">@Model.TotalEnrollments</div>
            <div class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">@Model.AverageEnrollmentsPerStudent.ToString("0.0", CultureInfo.InvariantCulture) avg per student</div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="card">
            <div class="card-header">
                <h3 class="font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">Enrollment Trend</h3>
                <span class="badge badge-info">Last @trend.Count months</span>
            </div>
            <div class="card-body space-y-4">
                @if (trend.Count == 0)
                {
                    <p class="text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">No enrollment history yet.</p>
                }
                else
                {
                    @foreach (var point in trend)
                    {
                        var width = Math.Max(2, (int)Math.Round(point.Value / (double)maxTrend * 100));
                        <div>
                            <div class="mb-1 flex items-center justify-between text-body-sm">
                                <span class="font-medium text-light-on-surface dark:text-dark-on-surface">@point.Label</span>
                                <span class="font-semibold text-primary tabular-nums">@point.Value</span>
                            </div>
                            <div class="stat-bar"><div class="progress-fill" style="width: @(width)%"></div></div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">Demand by Course</h3>
                <a asp-controller="Course" asp-action="Index" class="text-label-md font-semibold text-accent hover:underline">View catalog</a>
            </div>
            <div class="card-body space-y-4">
                @if (Model.EnrollmentsByCourse.Count == 0)
                {
                    <p class="text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">No course demand recorded yet.</p>
                }
                else
                {
                    @foreach (var point in Model.EnrollmentsByCourse)
                    {
                        var width = Math.Max(2, (int)Math.Round(point.Value / (double)maxCourse * 100));
                        <div>
                            <div class="mb-1 flex items-center justify-between text-body-sm">
                                <span class="font-medium text-light-on-surface dark:text-dark-on-surface">@point.Label</span>
                                <span class="font-semibold text-accent tabular-nums">@point.Value</span>
                            </div>
                            <div class="stat-bar"><div class="h-full rounded-full bg-accent" style="width: @(width)%"></div></div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="card">
            <div class="card-header">
                <h3 class="font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">Students by Program</h3>
            </div>
            <div class="card-body space-y-4">
                @if (Model.StudentsByProgram.Count == 0)
                {
                    <p class="text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">No programs registered.</p>
                }
                else
                {
                    @foreach (var point in Model.StudentsByProgram)
                    {
                        var width = Math.Max(2, (int)Math.Round(point.Value / (double)maxProgram * 100));
                        <div>
                            <div class="mb-1 flex items-center justify-between text-body-sm">
                                <span class="truncate pr-2 text-light-on-surface dark:text-dark-on-surface">@point.Label</span>
                                <span class="font-semibold text-light-on-surface tabular-nums dark:text-dark-on-surface">@point.Value</span>
                            </div>
                            <div class="stat-bar"><div class="progress-fill" style="width: @(width)%"></div></div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card lg:col-span-2">
            <div class="card-header">
                <h3 class="font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">Recently Admitted Students</h3>
                <a asp-controller="Student" asp-action="Index" class="text-label-md font-semibold text-accent hover:underline">All students</a>
            </div>
            <div class="overflow-x-auto">
                <table class="table-lumina">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Program</th>
                            <th>Year</th>
                            <th>Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentStudents.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">No recent students.</td></tr>
                        }
                        else
                        {
                            @foreach (var student in Model.RecentStudents)
                            {
                                <tr>
                                    <td>
                                        <div class="flex items-center gap-3">
                                            <span class="avatar avatar-initials h-8 w-8 text-[11px]">@UiFormat.Initials(student.FullName)</span>
                                            <div class="min-w-0">
                                                <div class="truncate font-semibold text-light-on-surface dark:text-dark-on-surface">@student.FullName</div>
                                                <div class="truncate text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">@student.StudentCode</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-light-on-surface dark:text-dark-on-surface">@student.Program</td>
                                    <td class="tabular-nums">@student.EnrollmentYear</td>
                                    <td><partial name="Partials/_StatusBadge" model="UiFormat.StudentStatusBadge(student.Status)" /></td>
                                    <td class="text-right">
                                        <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id" class="text-label-md font-semibold text-primary hover:underline">View</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a asp-controller="Student" asp-action="Index" class="card flex items-center gap-3 p-4 transition-colors hover:border-accent/40">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-container text-primary"><span class="material-symbols-outlined">groups</span></span>
            <span class="text-label-lg font-semibold text-light-on-surface dark:text-dark-on-surface">Student Directory</span>
        </a>
        <a asp-controller="Course" asp-action="Index" class="card flex items-center gap-3 p-4 transition-colors hover:border-accent/40">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-container text-accent"><span class="material-symbols-outlined">menu_book</span></span>
            <span class="text-label-lg font-semibold text-light-on-surface dark:text-dark-on-surface">Course Catalog</span>
        </a>
        <a asp-controller="Users" asp-action="Index" class="card flex items-center gap-3 p-4 transition-colors hover:border-accent/40">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-warning-container text-warning"><span class="material-symbols-outlined">admin_panel_settings</span></span>
            <span class="text-label-lg font-semibold text-light-on-surface dark:text-dark-on-surface">Users &amp; Roles</span>
        </a>
        <a asp-controller="Csv" asp-action="Index" class="card flex items-center gap-3 p-4 transition-colors hover:border-accent/40">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-success-container text-success"><span class="material-symbols-outlined">cloud_sync</span></span>
            <span class="text-label-lg font-semibold text-light-on-surface dark:text-dark-on-surface">CSV Batch Hub</span>
        </a>
    </div>
</div>
