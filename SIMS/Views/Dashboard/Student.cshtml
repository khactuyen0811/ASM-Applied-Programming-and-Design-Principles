@model StudentDashboardStats?
@{
    ViewData["Title"] = "Student Dashboard";
    ViewData["Breadcrumb"] = "Student Self-Service";
    ViewData["ActiveNav"] = "dashboard";
}

@if (Model is null)
{
    <div class="space-y-6">
        <div>
            <h2 class="page-title">Student Dashboard</h2>
            <p class="page-subtitle">Your academic summary will appear here.</p>
        </div>
        <div class="card p-6">
            <partial name="Partials/_EmptyState" model="@(new EmptyStateModel { Icon = "person", Title = "No student record linked", Message = "Your account is not linked to a student profile yet. Contact the registrar for assistance.", ActionText = "Course Catalog", ActionUrl = "Index", ActionController = "Course" })" />
        </div>
    </div>
}
else
{
    var progress = Model.TotalCredits <= 0 ? 0 : (int)Math.Round(Model.EarnedCredits / (double)Model.TotalCredits * 100);
    <div class="space-y-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
                <span class="avatar avatar-initials h-14 w-14 text-lg">@UiFormat.Initials(Model.FullName)</span>
                <div>
                    <h2 class="font-headline text-headline-lg font-bold text-light-on-surface dark:text-dark-on-surface">@Model.FullName</h2>
                    <p class="page-subtitle">@Model.StudentCode &bull; @Model.Program &bull; Cohort @Model.EnrollmentYear</p>
                </div>
                <partial name="Partials/_StatusBadge" model="UiFormat.StudentStatusBadge(Model.Status)" />
            </div>
            <div class="flex gap-2">
                <a asp-controller="Enrollment" asp-action="Index" class="btn btn-primary">
                    <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
                    <span>Course Registration</span>
                </a>
                <a asp-controller="Course" asp-action="Index" class="btn btn-secondary">
                    <span class="material-symbols-outlined text-[18px]">menu_book</span>
                    <span>Browse Catalog</span>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            <div class="kpi-card">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Cumulative GPA</span>
                <div class="mt-3 font-headline text-headline-xl font-bold text-primary tabular-nums">@(Model.Gpa.HasValue ? Model.Gpa.Value.ToString("0.00", CultureInfo.InvariantCulture) : "--")</div>
                <div class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">Out of 4.00 scale</div>
            </div>
            <div class="kpi-card">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Enrolled Courses</span>
                <div class="mt-3 font-headline text-headline-xl font-bold text-light-on-surface tabular-nums dark:text-dark-on-surface">@Model.CourseCount</div>
                <div class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">Active registrations</div>
            </div>
            <div class="kpi-card">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Earned Credits</span>
                <div class="mt-3 font-headline text-headline-xl font-bold text-success tabular-nums">@Model.EarnedCredits</div>
                <div class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">of @Model.TotalCredits total credits</div>
            </div>
            <div class="kpi-card">
                <span class="text-label-md font-semibold uppercase tracking-wide text-light-on-surface-muted dark:text-dark-on-surface-muted">Degree Progress</span>
                <div class="mt-3 font-headline text-headline-xl font-bold text-accent tabular-nums">@progress%</div>
                <div class="mt-2 stat-bar"><div class="h-full rounded-full bg-accent" style="width: @(progress)%"></div></div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">My Courses</h3>
                <span class="badge badge-info">@Model.Courses.Count enrolled</span>
            </div>
            <div class="card-body">
                @if (Model.Courses.Count == 0)
                {
                    <partial name="Partials/_EmptyState" model="@(new EmptyStateModel { Icon = "school", Title = "No course registrations", Message = "You have not registered for any courses this term. Browse the catalog and enroll in available sections.", ActionText = "Register for Courses", ActionUrl = "Index", ActionController = "Enrollment" })" />
                }
                else
                {
                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var course in Model.Courses)
                        {
                            <article class="flex flex-col justify-between rounded-xl border border-light-border bg-light-surface-subtle p-5 dark:border-dark-border dark:bg-dark-surface-subtle">
                                <div>
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="rounded bg-primary-container px-2.5 py-0.5 text-label-sm font-bold text-primary">@course.CourseCode</span>
                                        <partial name="Partials/_StatusBadge" model="@(new BadgeModel { Text = UiFormat.FormatGrade(course.Grade), Tone = UiFormat.GradeTone(course.Grade) })" />
                                    </div>
                                    <h4 class="mt-2 font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">@course.CourseName</h4>
                                    <p class="mt-1 text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">@course.Credits credits &bull; @course.LecturerName</p>
                                </div>
                                <div class="mt-4 flex items-center justify-between border-t border-light-border pt-3 dark:border-dark-border">
                                    <span class="text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">Enrolled @UiFormat.FormatDate(course.EnrolledAt)</span>
                                    <a asp-controller="Course" asp-action="Details" asp-route-id="@course.CourseId" class="text-label-md font-semibold text-primary hover:underline">Details</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
