@{
    ViewData["Title"] = "Welcome";
}

<div class="flex min-h-[60vh] items-center justify-center">
    <div class="card w-full max-w-lg p-8 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-accent-container text-accent">
            <img src="~/lumina/img/lumina-mark.svg" alt="" class="h-10 w-10" />
        </div>
        <h1 class="mt-4 font-headline text-headline-lg font-bold text-light-on-surface dark:text-dark-on-surface">Welcome to SIMS Lumina</h1>
        <p class="mt-2 text-body-md text-light-on-surface-muted dark:text-dark-on-surface-muted">
            Your session is being routed to the appropriate institutional workspace.
        </p>
        <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Open Dashboard</a>
            <a asp-controller="Login" asp-action="Index" class="btn btn-secondary">Sign In</a>
        </div>
    </div>
</div>
