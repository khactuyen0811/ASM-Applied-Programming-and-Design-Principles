@model UserDetails
@{
    ViewData["Title"] = "User Account";
    ViewData["Breadcrumb"] = Model.DisplayName;
    ViewData["ActiveNav"] = "users";
    var roleLabel = Model.Role switch
    {
        UserRole.Admin => "System Administrator",
        UserRole.Lecturer => "Faculty Member",
        _ => "Student"
    };
}

<div class="space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <a asp-action="Index" class="btn btn-secondary w-fit">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to Users</span>
        </a>
        <div class="flex flex-wrap gap-2">
            @if (Model.StudentId.HasValue)
            {
                <a asp-controller="Student" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-secondary">Open Student Record</a>
            }
            @if (Model.TeacherId.HasValue)
            {
                <a asp-controller="Teacher" asp-action="Details" asp-route-id="@Model.TeacherId" class="btn btn-secondary">Open Faculty Record</a>
            }
        </div>
    </div>

    <div class="card p-6">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
                <span class="avatar avatar-initials h-16 w-16 text-xl">@UiFormat.Initials(Model.DisplayName)</span>
                <div>
                    <div class="flex flex-wrap items-center gap-3">
                        <h2 class="font-headline text-headline-lg font-bold text-light-on-surface dark:text-dark-on-surface">@Model.DisplayName</h2>
                        <partial name="Partials/_StatusBadge" model="UiFormat.RoleBadge(Model.Role)" />
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-error">Suspended</span>
                        }
                    </div>
                    <p class="mt-1 font-mono text-body-md text-light-on-surface-muted dark:text-dark-on-surface-muted">@Model.Username</p>
                    <p class="text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">@roleLabel &bull; Created @UiFormat.FormatDate(Model.CreatedAt)</p>
                </div>
            </div>
            <div class="rounded-xl border border-light-border bg-light-surface-subtle p-4 text-body-sm dark:border-dark-border dark:bg-dark-surface-subtle">
                <div class="text-light-on-surface-muted dark:text-dark-on-surface-muted">Linked Email</div>
                <div class="font-semibold text-light-on-surface dark:text-dark-on-surface">@(string.IsNullOrWhiteSpace(Model.LinkedEmail) ? "Not linked" : Model.LinkedEmail)</div>
                @if (!string.IsNullOrWhiteSpace(Model.LinkedName))
                {
                    <div class="mt-2 text-light-on-surface-muted dark:text-dark-on-surface-muted">Linked Name</div>
                    <div class="font-semibold text-light-on-surface dark:text-dark-on-surface">@Model.LinkedName</div>
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="card">
            <div class="card-header">
                <h3 class="font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">Role Assignment</h3>
            </div>
            <form asp-action="UpdateRole" method="post" class="card-body space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@Model.Id" />
                <div>
                    <label for="detailRole" class="label">System Role</label>
                    <select id="detailRole" name="role" class="select">
                        <option value="1" selected="@(Model.Role == UserRole.Admin)">Admin</option>
                        <option value="2" selected="@(Model.Role == UserRole.Lecturer)">Lecturer</option>
                        <option value="3" selected="@(Model.Role == UserRole.Student)">Student</option>
                    </select>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="btn btn-primary">Save Role</button>
                </div>
            </form>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="font-headline text-headline-sm font-bold text-light-on-surface dark:text-dark-on-surface">Account Security</h3>
            </div>
            <div class="card-body space-y-3">
                <div class="flex items-center justify-between rounded-lg border border-light-border p-3 dark:border-dark-border">
                    <div>
                        <div class="text-label-md font-semibold text-light-on-surface dark:text-dark-on-surface">Account status</div>
                        <div class="text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">@(Model.IsActive ? "User can sign in." : "Sign-in is blocked.")</div>
                    </div>
                    <form asp-action="SetActive" method="post" data-confirm="@(Model.IsActive ? "Suspend this account?" : "Activate this account?")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.Id" />
                        <input type="hidden" name="active" value="@(Model.IsActive ? "false" : "true")" />
                        <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-primary")">@(Model.IsActive ? "Suspend" : "Activate")</button>
                    </form>
                </div>
                <div class="flex items-center justify-between rounded-lg border border-light-border p-3 dark:border-dark-border">
                    <div>
                        <div class="text-label-md font-semibold text-light-on-surface dark:text-dark-on-surface">Password reset</div>
                        <div class="text-body-sm text-light-on-surface-muted dark:text-dark-on-surface-muted">Generate a temporary password.</div>
                    </div>
                    <form asp-action="ResetPassword" method="post" data-confirm="Generate a new temporary password for this user?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.Id" />
                        <button type="submit" class="btn btn-secondary">Reset Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
