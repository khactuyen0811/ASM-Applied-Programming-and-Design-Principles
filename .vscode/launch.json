{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch SIMS (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/SIMS/bin/Debug/net8.0/SIMS.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SIMS",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/SIMS/Views"
      }
    }
  ]
}
